DATASIFTER_DOMAIN=datasifter.example.com
DATASIFTER_DB_USERNAME=datasifter
DATASIFTER_DB_PASSWORD=replace-with-a-long-random-database-password
DATASIFTER_DB_ROOT_PASSWORD=replace-with-a-long-random-root-password
DATASIFTER_SECURITY_ADMIN_USERNAME=admin
DATASIFTER_SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
DATASIFTER_WORKER_TOKEN=replace-with-a-separate-long-random-worker-token
DATASIFTER_VAULT_TRANSIT_ADDRESS=https://vault.example.internal:8200
DATASIFTER_VAULT_TRANSIT_MOUNT=transit
DATASIFTER_VAULT_TRANSIT_KEY=datasifter
DATASIFTER_VAULT_TRANSIT_TOKEN_SECRET_FILE=./secrets/vault-transit-token
DATASIFTER_STORAGE_S3_ENDPOINT=https://minio.example.internal:9000
DATASIFTER_STORAGE_S3_REGION=us-east-1
DATASIFTER_STORAGE_S3_BUCKET=datasifter-workflows
DATASIFTER_STORAGE_S3_ACCESS_KEY_SECRET_FILE=./secrets/s3-access-key
DATASIFTER_STORAGE_S3_SECRET_KEY_SECRET_FILE=./secrets/s3-secret-key
DATASIFTER_PLUGIN_DIRECTORY=./plugins
# Only needed while migrating secrets encrypted with the local passphrase provider.
DATASIFTER_VAULT_PASSPHRASE=
